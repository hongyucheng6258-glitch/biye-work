# Docker Compose 环境变量示例（请复制为 .env 后按需修改）
# R5 起：JWT_SECRET / SIGNIN_SECRET / REDIS_PASSWORD 为必填，缺省时 docker compose 直接报错拒绝启动。
# 生成长随机密钥示例：openssl rand -hex 32
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DB=ai_campus_platform
# 必填：Redis 密码，服务端 requirepass 与后端客户端必须一致
REDIS_PASSWORD=change-me-redis-password
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
# 必填：JWT 签名密钥（>=32 字符随机串，不得使用仓库默认值）
JWT_SECRET=replace-with-a-long-random-secret
# 必填：签到二维码 HMAC 密钥（>=16 字符随机串）
SIGNIN_SECRET=replace-with-another-long-random-secret
TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
